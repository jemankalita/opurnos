# Copy to .env.local. Every value is optional in development:
# with no MODEL_API_KEY the app runs in demo mode (heuristic agents, clearly labelled).

APP_URL=http://localhost:3000

# --- Meta Model API (https://dev.meta.ai) ---
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_DEFAULT=muse-spark-1.3
# Cheaper, but Meta may train on inputs. Only ever used for PUBLIC listing data.
MODEL_PUBLIC=muse-spark-1.3-contributor
MODEL_AGENT=muse-wonder-1.0

# --- Database ---
# Empty => embedded Postgres (PGlite) stored in DATA_DIR. Set for Supabase/Neon in production.
DATABASE_URL=
DATA_DIR=.data

# --- Auth & jobs ---
# 32+ random chars. Required in production:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Protects /api/cron/* in production (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- Email (https://resend.com). Empty => emails go to the local outbox at /dev/outbox ---
RESEND_API_KEY=
EMAIL_FROM=Opurnos <radar@yourdomain.com>

# --- Apply agent ---
# Empty => the agent runs inside the app process (local dev). Set to the worker URL in production.
APPLY_WORKER_URL=
APPLY_WORKER_SECRET=
BROWSER_CHANNEL=chrome
BROWSER_EXECUTABLE=
BROWSER_HEADLESS=true

# --- Guardrails ---
DAILY_LLM_BUDGET_USD=0.5
DAILY_APPLY_CAP=10

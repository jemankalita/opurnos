# Copy to .env.local. Every value is optional in development:
# with no OPENAI_API_KEY the app runs rules-only (heuristic agents, clearly labelled), and with
# no Razorpay keys billing is off and every account gets Pro features.

APP_URL=http://localhost:3000

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works; MODEL_API_KEY overrides OPENAI_API_KEY if both are set.
MODEL_BASE_URL=https://api.openai.com/v1
# Resume reading, eligibility judging, tailoring, verifying, referrals, web search.
MODEL_DEFAULT=gpt-6.1-terra
# High-volume rule extraction from PUBLIC listings only; no user data is sent with it.
MODEL_PUBLIC=gpt-6-luna
# The browser agent that fills application forms (vision + tools).
MODEL_AGENT=gpt-6.1-sol

# --- Database ---
# Empty => embedded Postgres (PGlite) stored in DATA_DIR. Set for Supabase/Neon in production.
DATABASE_URL=
DATA_DIR=.data

# --- Auth & jobs ---
# 32+ random chars. Required in production:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Protects /api/cron/* in production (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# --- Email (https://resend.com). Empty => emails go to the local outbox at /dev/outbox ---
RESEND_API_KEY=
EMAIL_FROM=Opurnos <radar@yourdomain.com>

# --- Apply agent ---
# Empty => the agent runs inside the app process (local dev). Set to the worker URL in production.
APPLY_WORKER_URL=
APPLY_WORKER_SECRET=
BROWSER_CHANNEL=chrome
BROWSER_EXECUTABLE=
BROWSER_HEADLESS=true

# --- Billing (https://dashboard.razorpay.com) ---
# Create a monthly plan under Subscriptions > Plans and paste its id. Add a webhook pointing at
# https://<your domain>/api/billing/webhook with the subscription.* events and a secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
# Shown on the pricing page; must match the plan's amount in Razorpay.
PRO_PRICE_INR=199

# --- Plan guardrails ---
# Daily AI spend per account in USD, and browser applications per day on Pro.
FREE_DAILY_AI_USD=0.05
PRO_DAILY_AI_USD=0.5
PRO_DAILY_APPLY_CAP=10

# --- Business details (shown on the legal and contact pages; Razorpay checks them) ---
COMPANY_NAME=Opurnos
SUPPORT_EMAIL=support@yourdomain.com
COMPANY_ADDRESS=
GRIEVANCE_OFFICER=
